# Normalize line endings for text files across Windows / Linux / macOS.
* text=auto

# PHP, templates, configs — always LF in the repository.
*.php text eol=lf
*.phtml text eol=lf
*.inc text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.htaccess text eol=lf

# Binary assets — do not touch line endings.
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary
