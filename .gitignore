# =============================================================================
# B. BITRIX RUNTIME — кеш, временные файлы, логи, обновления
# =============================================================================
# Кеш и runtime-каталоги Bitrix. Создаются автоматически, постоянно меняются
# и не должны попадать в git.

# --- Кеш Bitrix (обязательно) ---
/bitrix/cache/
/bitrix/managed_cache/
/bitrix/stack_cache/
/bitrix/html_pages/
/bitrix/tmp/

# --- Прочий runtime Bitrix ---
/bitrix/resize_cache/
/bitrix/managed_flags/
/bitrix/catalog_export/
/bitrix/controller_log/
/bitrix/updates/
/bitrix/site_checker_*.log
/bitrix/modules/updater.log
/bitrix/modules/updater_partner.log
/bitrix/modules/serverfilelog*

/upload/resize_cache/
/upload/tmp/

/tmp/
/dev-*

# --- Логи ---
*.log
*.log.*
/bitrix/log.txt
/bitrix/*.log

# --- Временные файлы ---
*.tmp
*.temp
*.pid
*.swp
*.swo
*.swq
*~

/.htaccess_back*
/.well-known/

# =============================================================================
# B2. ВЫГРУЗКИ, SEO, ТЕКСТ, БЭКАПЫ, УСТАРЕВШИЕ КОПИИ
# =============================================================================
# Сгенерированные и служебные файлы: карты сайта, фиды, экспорты, бэкапы.
# robots.txt — исключение: храним в репозитории (см. ниже).

# --- Карта сайта и маркетплейс-фиды ---
/sitemap_iblock*
/sitemap_files*
/sitemap.xml
/sitemap*.xml
/sitemap*.xml.gz
/y-market/*.xml
/y-market/

# --- Импорт/экспорт инфоблоков и прочие выгрузки ---
/*_files/
/*_files.zip
/*_files.tar.gz
/~*.xml
/.part*.xml
~*

# --- Текстовые файлы (robots.txt храним в репозитории) ---
*.txt
!/robots.txt

# --- Бэкапы ---
/bitrix/backup/
/bitrix/backup_auto/
/backup/
/backups/
/**/*.backup
*.backup
*.bak
*.BAK
*.old

# --- Устаревшие папки и файлы (*_old) ---
*_old
*_old/
**/*_old
**/*_old/
**/*_old/**

