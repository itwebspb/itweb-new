# =============================================================================
# F. ШАБЛОНЫ САЙТОВ — все шаблоны сайтов в репозитории
# =============================================================================
# .default — системные шаблоны компонентов ядра, не шаблон сайта.
# Все остальные каталоги bitrix/templates/* — шаблоны сайтов, версионируем.
# local/templates/ — кастомные шаблоны, всегда в репозитории.

/bitrix/templates/.default/
/bitrix/templates/.default/**

# Шаблоны сайтов, обнаруженные при сканировании:
!/bitrix/templates/aspro_max/
!/bitrix/templates/aspro_max/**
!/bitrix/templates/aspro_max_mail/
!/bitrix/templates/aspro_max_mail/**
!/bitrix/templates/calendar_sharing/
!/bitrix/templates/calendar_sharing/**
!/bitrix/templates/landing24/
!/bitrix/templates/landing24/**
!/bitrix/templates/learning/
!/bitrix/templates/learning/**
!/bitrix/templates/mail_user/
!/bitrix/templates/mail_user/**

!/local/templates/
!/local/templates/**

# =============================================================================
# G. LOCAL/ — пользовательская разработка (всегда в репозитории)
# =============================================================================
# Папка local/ не игнорируется. Здесь: modules, components, templates,
# php_interface, routes, blocks, js и прочий кастомный код.
# Исключения ниже — только секреты и локальные настройки окружения.


# =============================================================================
# H. UPLOAD — пользовательский контент
# =============================================================================
# Файлы, загруженные через админку и механизмы Bitrix. Восстанавливаются
# из бэкапов, а не из git.

/upload/
!/upload/.gitkeep

# =============================================================================
# I. МЕДИА И АРХИВЫ — глобальные маски
# =============================================================================
# Контентные файлы не храним в git. Assets шаблонов и компонентов — исключения.

# --- Изображения ---
*.avif
*.bmp
*.gif
*.heic
*.heif
*.ico
*.jpg
*.jpeg
*.jxl
*.png
*.psd
*.raw
*.svg
*.tif
*.tiff
*.webp
*.ai
*.eps

# --- Видео и аудио ---
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.webm
*.wmv
